[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Signup popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "signup_popup_enable",
        "label": "Enable signup popup",
        "default": true
      },
      {
        "type": "range",
        "id": "signup_popup_delay",
        "label": "Delay before popup appears",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "s",
        "default": 2
      },
      {
        "type": "text",
        "id": "signup_popup_eyebrow",
        "label": "Eyebrow",
        "default": "Exclusive offer"
      },
      {
        "type": "text",
        "id": "signup_popup_title_line_1",
        "label": "Title line 1",
        "default": "Get 5% off"
      },
      {
        "type": "text",
        "id": "signup_popup_title_emphasis",
        "label": "Title emphasis",
        "default": "your first order."
      },
      {
        "type": "textarea",
        "id": "signup_popup_text",
        "label": "Description",
        "default": "Sign up to unlock 5% off your first order. Your discount is applied automatically at checkout — no code needed."
      },
      {
        "type": "text",
        "id": "signup_popup_button_label",
        "label": "Button label",
        "default": "Sign up & save 5%"
      },
      {
        "type": "text",
        "id": "signup_popup_disclaimer",
        "label": "Disclaimer",
        "default": "By signing up you agree to receive emails from IYOVA SKIN. Your 5% discount will be applied automatically at checkout on your first order."
      },
      {
        "type": "header",
        "content": "Success message"
      },
      {
        "type": "text",
        "id": "signup_popup_success_eyebrow",
        "label": "Success eyebrow",
        "default": "Welcome to IYOVA"
      },
      {
        "type": "text",
        "id": "signup_popup_success_title",
        "label": "Success title",
        "default": "You're in."
      },
      {
        "type": "textarea",
        "id": "signup_popup_success_text",
        "label": "Success message",
        "default": "Thank you for signing up. Your 5% off will be applied automatically at checkout on your first order."
      },
      {
        "type": "text",
        "id": "signup_popup_success_button",
        "label": "Success button",
        "default": "Continue shopping"
      }
    ]
  }
]
