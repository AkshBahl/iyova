<section class="contact-page full-width">
  <div class="contact-page__inner container-editorial">
    <div class="contact-page__grid">
      <div>
        <p class="text-eyebrow contact-page__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="font-display contact-page__title">{{ section.settings.title }}</h2>
        <p class="contact-page__text">{{ section.settings.text }}</p>

        <ul class="contact-page__details">
          {% if section.settings.email != blank %}
            <li><span>Email</span><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>
          {% endif %}
          {% if section.settings.phone != blank %}
            <li><span>Phone</span><a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a></li>
          {% endif %}
        </ul>
      </div>

      <div class="contact-page__form-wrap">
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <p class="contact-page__success">{{ 'sections.contact.success' | t }}</p>
          {% endif %}

          <div class="contact-page__field">
            <label for="ContactFormName">{{ 'sections.contact.name' | t }}</label>
            <input id="ContactFormName" type="text" name="contact[name]" required>
          </div>

          <div class="contact-page__field">
            <label for="ContactFormEmail">{{ 'sections.contact.email' | t }}</label>
            <input id="ContactFormEmail" type="email" name="contact[email]" required>
          </div>

          <div class="contact-page__field">
            <label for="ContactFormMessage">{{ 'sections.contact.message' | t }}</label>
            <textarea id="ContactFormMessage" name="contact[body]" rows="6" required></textarea>
          </div>

          <button type="submit" class="btn-red">{{ 'sections.contact.submit' | t }}</button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .contact-page {
    padding-bottom: 6rem;
  }

  .contact-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .contact-page__grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  .contact-page__eyebrow {
    color: var(--luxury-red);
  }

  .contact-page__title {
    margin-top: 1rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .contact-page__text {
    margin-top: 1.25rem;
    color: var(--muted-foreground);
    line-height: 1.7;
    max-width: 28rem;
  }

  .contact-page__details {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1rem;
  }

  .contact-page__details li {
    display: grid;
    gap: 0.25rem;
  }

  .contact-page__details span {
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .contact-page__details a {
    color: var(--text-dark);
    text-decoration: none;
  }

  .contact-page__form-wrap {
    background: var(--cream);
    padding: 2rem;
  }

  @media (min-width: 768px) {
    .contact-page__form-wrap {
      padding: 2.5rem;
    }
  }

  .contact-page__field {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .contact-page__field label {
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .contact-page__field input,
  .contact-page__field textarea {
    width: 100%;
    border: 1px solid rgba(45, 35, 35, 0.15);
    background: var(--ivory);
    padding: 0.875rem 1rem;
    color: var(--text-dark);
  }

  .contact-page__success {
    margin-bottom: 1rem;
    color: var(--luxury-red);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "title", "label": "Title", "default": "We'd love to hear from you." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Questions about products, orders, or your ritual — our team is here to help." },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@iyovaskin.com" },
    { "type": "text", "id": "phone", "label": "Phone" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
