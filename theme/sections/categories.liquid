<section class="categories full-width">
  <div class="categories__inner container-editorial">
    {% capture categories_title %}
      The <em>Best Seller.</em>
    {% endcapture %}
    {% render 'section-head',
      eyebrow: section.settings.eyebrow,
      eyebrow_position: 'below_title',
      title: categories_title,
      subtitle: section.settings.subtitle
    %}

    <div class="categories__grid">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          class="categories__item categories__item--{{ block.settings.layout }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: alt: block.settings.title, class: 'categories__image' }}
          {% else %}
            <img
              src="{{ block.settings.fallback_image | asset_url }}"
              alt="{{ block.settings.title }}"
              class="categories__image"
              loading="lazy"
            >
          {% endif %}
          <div class="categories__overlay"></div>
          <div class="categories__content">
            <p class="categories__eyebrow">{{ block.settings.eyebrow }}</p>
            <div>
              <h3 class="font-display categories__title">{{ block.settings.title }}</h3>
              <span class="categories__cta">{{ block.settings.cta | default: 'View product →' }}</span>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .categories {
    padding-block: 6rem;
  }

  @media (min-width: 768px) {
    .categories {
      padding-block: 9rem;
    }
  }

  .categories__inner .section-head {
    margin-bottom: 4rem;
  }

  .categories__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .categories__grid {
      gap: 1.5rem;
    }
  }

  .categories__item {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    color: var(--ivory);
    text-decoration: none;
  }

  .categories__item--tall {
    grid-column: span 12;
    aspect-ratio: 4 / 5;
  }

  .categories__item--regular {
    grid-column: span 6;
    aspect-ratio: 4 / 5;
  }

  .categories__item--short {
    grid-column: span 6;
    aspect-ratio: 3 / 4;
  }

  .categories__item--wide {
    grid-column: span 12;
    aspect-ratio: 16 / 10;
  }

  @media (min-width: 768px) {
    .categories__item--tall {
      grid-column: span 5;
      grid-row: span 2;
      aspect-ratio: 4 / 6;
    }

    .categories__item--regular {
      grid-column: span 4;
    }

    .categories__item--short {
      grid-column: span 3;
    }

    .categories__item--wide {
      grid-column: span 7;
    }
  }

  .categories__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .categories__item:hover .categories__image {
    transform: scale(1.06);
  }

  .categories__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(45, 35, 35, 0.5), transparent 55%);
    transition: background 0.7s ease;
  }

  .categories__item:hover .categories__overlay {
    background: linear-gradient(to top, rgba(45, 35, 35, 0.65), transparent 55%);
  }

  .categories__content {
    position: absolute;
    inset: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .categories__content {
      padding: 2.5rem;
    }
  }

  .categories__eyebrow {
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .categories__title {
    font-size: clamp(1.875rem, 4vw, 3rem);
    line-height: 1;
    transition: transform 0.7s ease;
  }

  .categories__item:hover .categories__title {
    transform: translateY(-4px);
  }

  .categories__cta {
    display: inline-flex;
    margin-top: 0.75rem;
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop the range"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Our most-loved devices — trusted favourites chosen again and again."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Product",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product name"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "01 / Device"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product link"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Link label",
          "default": "View product →"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "default": "regular",
          "options": [
            { "value": "tall", "label": "Tall" },
            { "value": "regular", "label": "Regular" },
            { "value": "short", "label": "Short" },
            { "value": "wide", "label": "Wide" }
          ]
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback asset filename",
          "default": "cat-face.jpg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product showcase",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "LED facial therapy mask",
            "eyebrow": "01 / Device",
            "layout": "tall",
            "fallback_image": "cat-face.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Air multi-styler",
            "eyebrow": "02 / Device",
            "layout": "regular",
            "fallback_image": "cat-hair.jpg"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Facial sculpting device",
            "eyebrow": "03 / Device",
            "layout": "short",
            "fallback_image": "cat-body.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
