<section class="journal full-width">
  <div class="journal__inner container-editorial">
    <div class="journal__header">
      {% capture journal_title %}
        The IYOVA <em>Journal.</em>
      {% endcapture %}
      {% render 'section-head', eyebrow: section.settings.eyebrow, title: journal_title %}

      {% if section.settings.blog != blank %}
        <a href="{{ section.settings.blog.url }}" class="journal__view-all">Read All Articles →</a>
      {% endif %}
    </div>

    <div class="journal__grid">
      {% if section.settings.blog != blank %}
        {% for article in section.settings.blog.articles limit: section.settings.articles_to_show %}
          <a href="{{ article.url }}" class="journal__card">
            <div class="journal__media">
              {% if article.image %}
                {{ article.image | image_url: width: 800 | image_tag: alt: article.image.alt, class: 'journal__image', loading: 'lazy' }}
              {% else %}
                {{ 'blog-apparel-1' | placeholder_svg_tag: 'journal__image journal__placeholder' }}
              {% endif %}
            </div>
            <div class="journal__body">
              <p class="journal__meta">{{ article.tags.first | default: 'Editorial' }}</p>
              <h3 class="journal__title">{{ article.title }}</h3>
              <span class="journal__cta">Read Article →</span>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <article class="journal__card journal__card--placeholder">
            <div class="journal__media">
              {{ 'blog-apparel-1' | placeholder_svg_tag: 'journal__image journal__placeholder' }}
            </div>
            <div class="journal__body">
              <p class="journal__meta">Connect a blog</p>
              <h3 class="journal__title">Add journal articles in Shopify admin</h3>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .journal {
    padding-block: 6rem;
  }

  @media (min-width: 768px) {
    .journal {
      padding-block: 9rem;
    }
  }

  .journal__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .journal__view-all {
    display: none;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-dark);
    text-decoration: none;
  }

  .journal__view-all:hover {
    color: var(--luxury-red);
  }

  @media (min-width: 768px) {
    .journal__view-all {
      display: inline-flex;
    }
  }

  .journal__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .journal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  .journal__card {
    color: inherit;
    text-decoration: none;
  }

  .journal__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--cream);
  }

  .journal__image,
  .journal__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s ease;
  }

  .journal__card:hover .journal__image {
    transform: scale(1.05);
  }

  .journal__body {
    padding-top: 1.5rem;
  }

  .journal__meta {
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--luxury-red);
  }

  .journal__title {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .journal__card:hover .journal__title {
    color: var(--luxury-red);
  }

  .journal__cta {
    display: inline-flex;
    margin-top: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Editorial" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [{ "name": "Journal" }]
}
{% endschema %}
