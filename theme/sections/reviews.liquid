<section class="reviews full-width">
  <div class="reviews__inner container-editorial">
    {% capture reviews_title %}
      Loved in <em>every</em> ritual.
    {% endcapture %}
    {% render 'section-head', eyebrow: section.settings.eyebrow, title: reviews_title %}

    <div class="reviews__grid">
      {% for block in section.blocks %}
        <article class="reviews__card reviews__card--{{ forloop.index }}" {{ block.shopify_attributes }}>
          <blockquote class="reviews__quote">"{{ block.settings.quote }}"</blockquote>
          <footer class="reviews__footer">
            <p class="reviews__name">{{ block.settings.name }}</p>
            <p class="reviews__product">{{ block.settings.product }}</p>
          </footer>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .reviews {
    padding-block: 6rem;
  }

  @media (min-width: 768px) {
    .reviews {
      padding-block: 9rem;
    }
  }

  .reviews__inner .section-head {
    margin-bottom: 3.5rem;
  }

  .reviews__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .reviews__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .reviews__card--1,
    .reviews__card--4 {
      grid-column: span 5;
    }

    .reviews__card--2,
    .reviews__card--3 {
      grid-column: span 7;
    }
  }

  .reviews__card {
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .reviews__card {
      padding: 3rem;
    }
  }

  .reviews__card--1,
  .reviews__card--3 {
    background: var(--cream);
  }

  .reviews__card--2,
  .reviews__card--4 {
    background: rgba(216, 197, 191, 0.6);
  }

  .reviews__quote {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    line-height: 1.3;
  }

  .reviews__footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(45, 35, 35, 0.15);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .reviews__name {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .reviews__product {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    text-align: right;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name", "default": "Amara L." },
        { "type": "text", "id": "product", "label": "Product", "default": "IYOVA LED Facial Therapy Mask" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "It's become the most considered part of my evening. My skin has never looked more luminous — genuinely elevated.", "name": "Amara L.", "product": "IYOVA LED Facial Therapy Mask" } },
        { "type": "review", "settings": { "quote": "Salon-quality without the salon. The design alone feels like a small daily indulgence.", "name": "Sienna R.", "product": "IYOVA Air Multi-Styler" } },
        { "type": "review", "settings": { "quote": "Visible, quiet confidence. Two weeks in and I noticed the difference in the mirror before anyone else did.", "name": "Noor K.", "product": "IYOVA Facial Sculpting Device" } },
        { "type": "review", "settings": { "quote": "The most elegant recovery tool I've ever owned. It looks as considered as it feels.", "name": "Vivienne T.", "product": "IYOVA Body Recovery Massager" } }
      ]
    }
  ]
}
{% endschema %}
