{% doc %}
  Renders an IYOVA product card.

  @param {product} product - Shopify product object
{% enddoc %}

<article class="product-card">
  <div class="product-card__media">
    {% if product.tags contains 'best-seller' %}
      <span class="product-card__badge">Best Seller</span>
    {% elsif product.tags contains 'new' %}
      <span class="product-card__badge">New</span>
    {% elsif product.tags contains 'loved' %}
      <span class="product-card__badge">Loved</span>
    {% endif %}

    <a href="{{ product.url }}" class="product-card__image-link">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 800 | image_tag: alt: product.featured_image.alt, class: 'product-card__image', loading: 'lazy' }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
      {% endif %}
    </a>

    {% if product.available %}
      <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-add">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="product-card__quick-add-btn">
          Quick Add
        </button>
      </form>
    {% endif %}
  </div>

  <div class="product-card__body">
    {% if product.type != blank %}
      <p class="product-card__type">{{ product.type }}</p>
    {% endif %}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    {% if product.description != blank %}
      <p class="product-card__excerpt">{{ product.description | strip_html | truncate: 72 }}</p>
    {% endif %}
    <div class="product-card__meta">
      <span class="product-card__price">{{ product.price | money }}</span>
      <span class="product-card__rating" aria-hidden="true">★ 5.0</span>
    </div>
  </div>
</article>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
  }

  .product-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--cream);
  }

  .product-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    background: var(--ivory);
    padding: 0.375rem 0.625rem;
    color: var(--luxury-red);
  }

  .product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__image,
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__quick-add {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1rem;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .product-card:hover .product-card__quick-add {
    opacity: 1;
    transform: translateY(0);
  }

  .product-card__quick-add-btn {
    width: 100%;
    border: none;
    background: var(--ivory);
    color: var(--text-dark);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 0.875rem 1rem;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .product-card__quick-add-btn:hover {
    background: var(--text-dark);
    color: var(--ivory);
  }

  .product-card__body {
    padding-top: 1.25rem;
    display: grid;
    gap: 0.375rem;
  }

  .product-card__type {
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .product-card__title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-card__excerpt {
    font-size: 0.875rem;
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-card__meta {
    margin-top: 0.5rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
  }

  .product-card__price {
    font-family: var(--font-serif);
    font-size: 1.25rem;
  }

  .product-card__rating {
    font-size: 0.75rem;
    color: var(--luxury-red);
  }
{% endstylesheet %}
