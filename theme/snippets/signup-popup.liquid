{% doc %}
  Renders the first-visit signup popup with a customer marketing form.

  Controlled via theme settings under "Signup popup".
{% enddoc %}

{% if settings.signup_popup_enable %}
  <signup-popup
    class="signup-popup"
    data-delay="{{ settings.signup_popup_delay | times: 1000 }}"
    hidden
  >
    <div class="signup-popup__overlay" data-signup-popup-close></div>

    <div
      class="signup-popup__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="SignupPopupTitle"
    >
      <button type="button" class="signup-popup__close" data-signup-popup-close aria-label="Close">
        ×
      </button>

      {% form 'customer', id: 'SignupPopupForm', class: 'signup-popup__form', return_to: request.path %}
        <input type="hidden" name="contact[tags]" value="newsletter, signup-popup, first-order-5">
        <input type="hidden" name="contact[accepts_marketing]" value="true">

        {% if form.posted_successfully? %}
          <div class="signup-popup__success">
            <p class="text-eyebrow signup-popup__eyebrow">{{ settings.signup_popup_success_eyebrow }}</p>
            <h2 id="SignupPopupTitle" class="font-display signup-popup__title">{{ settings.signup_popup_success_title }}</h2>
            <p class="signup-popup__text">{{ settings.signup_popup_success_text }}</p>
            <button type="button" class="btn-red signup-popup__done" data-signup-popup-close>
              {{ settings.signup_popup_success_button }}
            </button>
          </div>
        {% else %}
          <p class="text-eyebrow signup-popup__eyebrow">{{ settings.signup_popup_eyebrow }}</p>
          <h2 id="SignupPopupTitle" class="font-display signup-popup__title">
            {{ settings.signup_popup_title_line_1 }}
            <em>{{ settings.signup_popup_title_emphasis }}</em>
          </h2>
          <p class="signup-popup__text">{{ settings.signup_popup_text }}</p>

          {% if form.errors %}
            <p class="signup-popup__error">
              {% if form.errors.messages.email %}
                {{ form.errors.messages.email }}
              {% else %}
                Please check your details and try again.
              {% endif %}
            </p>
          {% endif %}

          <div class="signup-popup__fields">
            <div class="signup-popup__field">
              <label for="SignupPopupFirstName">{{ 'sections.signup_popup.first_name' | t }}</label>
              <input
                id="SignupPopupFirstName"
                type="text"
                name="contact[first_name]"
                autocomplete="given-name"
                required
              >
            </div>

            <div class="signup-popup__field">
              <label for="SignupPopupLastName">{{ 'sections.signup_popup.last_name' | t }}</label>
              <input
                id="SignupPopupLastName"
                type="text"
                name="contact[last_name]"
                autocomplete="family-name"
                required
              >
            </div>

            <div class="signup-popup__field signup-popup__field--full">
              <label for="SignupPopupEmail">{{ 'sections.signup_popup.email' | t }}</label>
              <input
                id="SignupPopupEmail"
                type="email"
                name="contact[email]"
                autocomplete="email"
                required
              >
            </div>

            <div class="signup-popup__field signup-popup__field--full">
              <label for="SignupPopupPhone">{{ 'sections.signup_popup.phone' | t }}</label>
              <input
                id="SignupPopupPhone"
                type="tel"
                name="contact[note]"
                autocomplete="tel"
                required
              >
            </div>
          </div>

          <button type="submit" class="btn-red signup-popup__submit">
            {{ settings.signup_popup_button_label }}
          </button>

          <p class="signup-popup__disclaimer">{{ settings.signup_popup_disclaimer }}</p>
        {% endif %}
      {% endform %}
    </div>
  </signup-popup>
{% endif %}

{% stylesheet %}
  .signup-popup {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .signup-popup[hidden] {
    display: none;
  }

  .signup-popup.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .signup-popup.is-visible[hidden] {
    display: grid;
  }

  .signup-popup__overlay {
    position: absolute;
    inset: 0;
    background: rgba(45, 35, 35, 0.55);
    backdrop-filter: blur(4px);
  }

  .signup-popup__dialog {
    position: relative;
    z-index: 1;
    width: min(100%, 34rem);
    max-height: min(92vh, 44rem);
    overflow: auto;
    padding: 2rem 1.75rem;
    background: var(--ivory);
    color: var(--text-dark);
    box-shadow: 0 24px 80px rgba(45, 35, 35, 0.18);
  }

  @media (min-width: 768px) {
    .signup-popup__dialog {
      padding: 2.5rem;
    }
  }

  .signup-popup__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    background: transparent;
    color: var(--text-dark);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.65;
    transition: opacity 0.3s ease;
  }

  .signup-popup__close:hover {
    opacity: 1;
  }

  .signup-popup__eyebrow {
    color: var(--luxury-red);
  }

  .signup-popup__title {
    margin-top: 0.85rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.02;
  }

  .signup-popup__title em {
    font-style: italic;
    color: var(--luxury-red);
    font-weight: 300;
  }

  .signup-popup__text {
    margin-top: 1rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .signup-popup__error {
    margin-top: 1rem;
    color: var(--luxury-red);
    font-size: 0.875rem;
  }

  .signup-popup__fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .signup-popup__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .signup-popup__field {
    display: grid;
    gap: 0.45rem;
  }

  .signup-popup__field--full {
    grid-column: 1 / -1;
  }

  .signup-popup__field label {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .signup-popup__field input {
    width: 100%;
    padding: 0.85rem 0.9rem;
    border: 1px solid rgba(45, 35, 35, 0.15);
    background: var(--cream);
    color: var(--text-dark);
    font: inherit;
    outline: none;
    transition: border-color 0.3s ease;
  }

  .signup-popup__field input:focus {
    border-color: rgba(45, 35, 35, 0.35);
  }

  .signup-popup__submit,
  .signup-popup__done {
    width: 100%;
    margin-top: 1.5rem;
    justify-content: center;
  }

  .signup-popup__disclaimer {
    margin-top: 0.85rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted-foreground);
  }

  .signup-popup__success {
    text-align: center;
  }

  .signup-popup__success .signup-popup__text {
    max-width: 24rem;
    margin-inline: auto;
  }
{% endstylesheet %}

{% javascript %}
  class SignupPopup extends HTMLElement {
    connectedCallback() {
      this.storageKey = 'iyova-signup-popup';
      this.sessionKey = 'iyova-signup-popup-shown';
      this.dismissDays = 7;
      this.delay = Number(this.dataset.delay || 2000);
      this.closeButtons = this.querySelectorAll('[data-signup-popup-close]');
      this.hasSuccess = !!this.querySelector('.signup-popup__success');
      this.hasErrors = !!this.querySelector('.signup-popup__error');

      this.closeButtons.forEach((button) => {
        button.addEventListener('click', () => this.close(this.hasSuccess));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.classList.contains('is-visible')) {
          this.close(false);
        }
      });

      if (this.hasSuccess) {
        this.markSubscribed();
        this.markSessionShown();
        this.open();
        return;
      }

      if (this.hasErrors) {
        this.markSessionShown();
        this.open();
        return;
      }

      if (!this.shouldShow()) {
        return;
      }

      window.setTimeout(() => {
        this.markSessionShown();
        this.open();
      }, this.delay);
    }

    shouldShow() {
      try {
        if (sessionStorage.getItem(this.sessionKey) === 'true') {
          return false;
        }

        const stored = JSON.parse(localStorage.getItem(this.storageKey) || '{}');
        if (stored.subscribed) return false;

        if (stored.dismissed) {
          const dismissedAt = new Date(stored.dismissed).getTime();
          const elapsedDays = (Date.now() - dismissedAt) / (1000 * 60 * 60 * 24);
          if (elapsedDays < this.dismissDays) return false;
        }
      } catch (error) {
        return true;
      }

      return true;
    }

    markSessionShown() {
      try {
        sessionStorage.setItem(this.sessionKey, 'true');
      } catch (error) {
        /* ignore storage failures */
      }
    }

    open() {
      this.hidden = false;
      window.requestAnimationFrame(() => {
        this.classList.add('is-visible');
      });
      document.body.style.overflow = 'hidden';
    }

    close(subscribed) {
      this.classList.remove('is-visible');
      document.body.style.overflow = '';

      window.setTimeout(() => {
        this.hidden = true;
      }, 400);

      if (subscribed) {
        this.markSubscribed();
        return;
      }

      try {
        localStorage.setItem(
          this.storageKey,
          JSON.stringify({
            dismissed: new Date().toISOString()
          })
        );
      } catch (error) {
        /* ignore storage failures */
      }
    }

    markSubscribed() {
      try {
        localStorage.setItem(
          this.storageKey,
          JSON.stringify({
            subscribed: true
          })
        );
      } catch (error) {
        /* ignore storage failures */
      }
    }
  }

  customElements.define('signup-popup', SignupPopup);
{% endjavascript %}
